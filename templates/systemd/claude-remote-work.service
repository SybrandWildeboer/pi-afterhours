[Unit]
Description=Claude Remote Control (work profile, for Claude Desktop)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@PROJECTS@
Environment=CLAUDE_CONFIG_DIR=%h/.claude-profiles/work
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# remote-control draws a terminal UI, so give it a pseudo-terminal
ExecStart=/usr/bin/script -qfc "%h/.local/bin/claude remote-control --name @HOSTNAME@-work --permission-mode default --capacity 3 --settings /etc/claude-remote-work-settings.json" /dev/null
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
