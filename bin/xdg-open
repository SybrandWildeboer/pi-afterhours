#!/bin/sh
# Headless Pi: lynx (the only browser here) can't complete Databricks login ("HTTP upgrade required").
# Print the URL on the user's terminal so it can be opened on the PC instead.
msg=$(printf '\n>>> OPEN THIS URL IN YOUR WINDOWS BROWSER:\n%s\n\n' "$1")
printf '%s\n' "$1" > "$HOME/.last-login-url"
{ printf '%s' "$msg" > /dev/tty; } 2>/dev/null || printf '%s' "$msg" >&2
exit 0
